# Copy to .env and fill in. The app will not start without the first three.
# After the first start, make your own account with:
#   docker compose exec web flask --app app create-owner you@example.com

# Password for the app's Postgres database. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login cookies and report links, and protects cashier PINs. Changing it
# means every PIN has to be set again. Generate with: openssl rand -hex 32
SECRET_KEY=

# The address people use to reach the site, used for links in emails
PUBLIC_URL=https://sales.example.com

# Mail server for invites, password resets and end-of-event reports. Without
# SMTP_HOST, emails are written to the app's log instead of being sent.
# SMTP_SECURITY is starttls (usually port 587), ssl (port 465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Stripe, for charging organizers per event. Use a restricted key (rk_...) with
# write access to Checkout Sessions only. Create one price per kind of event in the
# Stripe dashboard ($10 yard sale, $30 charity drive) and paste their ids here.
# Point a webhook at https://<your site>/api/stripe/webhook for the events
# checkout.session.completed and checkout.session.async_payment_succeeded, and
# paste its signing secret. Until these are set, paid events can't be paid for.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_YARD_SALE=
STRIPE_PRICE_CHARITY=

# Time zone new events start with. It decides which day a sale counts toward
# in reports, and can be changed per event.
POS_TIMEZONE=America/Chicago

# Port on the server
POS_PORT=5000

# Set to true when the app is served over HTTPS. Logins then only work
# through the HTTPS address, not http://<server-ip>:<port>.
COOKIE_SECURE=false

# IP address of your reverse proxy (such as nginx), so failed logins are
# tracked per visitor instead of all appearing to come from the proxy.
# Several can be listed with commas, and CIDR ranges are allowed.
TRUSTED_PROXY_IPS=
