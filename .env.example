# Copy to .env and fill in. The app will not start without the first two.

# Code typed on the login screen to add, edit, and remove cashiers
ADMIN_CODE=

# Signs login cookies and protects cashier PINs. Changing it means every PIN
# has to be set again. Generate with: openssl rand -hex 32
SECRET_KEY=

# Timezone that decides which day a sale counts toward in reports
POS_TIMEZONE=America/Chicago

# Port on the server
POS_PORT=5000

# Set to true only if the app is served over HTTPS
COOKIE_SECURE=false
